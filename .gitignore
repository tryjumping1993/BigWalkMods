# Unity generated
unity/Library/
unity/Temp/
unity/Logs/
unity/UserSettings/
unity/obj/
unity/*.csproj
unity/*.sln
unity/*.slnx

# Build output and scratch
logs/
previews/
world/

# Mod profile: third-party binaries and generated files (rebuildable from Thunderstore + a game launch)
profile/

# Third-party source clone (the .unitypackage beside it is kept)
vendor/BigPuzzleSDK-src/

# Game screenshots and companion build output
shots/
companion/obj/
companion/bin/
winterwalk/obj/
winterwalk/bin/

# The SDK builds this scene from the game's own files (357 MB of game geometry): never commit it
unity/Assets/BigPuzzleSDK/Internal/Map.unity
unity/Assets/BigPuzzleSDK/Internal/Map.unity.meta

# Generated by every build (meshes and textures made in code): rebuilt from the puzzle definitions
unity/Assets/Puzzles/*/Meshes/
unity/Assets/Puzzles/*/Meshes.meta
unity/Assets/Puzzles/*/FirBranch.png
unity/Assets/Puzzles/*/FirBranch.png.meta

# This machine's own settings for tools/bwm.ps1
bwm.local.ps1

# Snow surface maps: generated by tools/snowtex.py (bwm.ps1 build makes them); their import settings are kept
unity/Assets/Textures/Snow/*.png
