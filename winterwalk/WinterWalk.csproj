<Project Sdk="Microsoft.NET.Sdk">

  <!-- Winter Walk: the winter edition's own plugin, needed by every player. It gives the Winter Isle its sky and
       light by adjusting the game's sky system (Enviro) for each player as they come near the island.
       Build with tools\bwm.ps1 companion (the game must be closed). -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>WinterWalk</AssemblyName>
    <RootNamespace>WinterWalk</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Profile>$(MSBuildThisFileDirectory)..\profile\BepInEx</Profile>
    <OutputPath>$(Profile)\plugins\WinterWalk\</OutputPath>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NoWarn>$(NoWarn);MSB3277;CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(Profile)\core\BepInEx.Core.dll;$(Profile)\core\BepInEx.Unity.IL2CPP.dll;$(Profile)\core\Il2CppInterop.Runtime.dll;$(Profile)\core\Il2CppInterop.Common.dll;$(Profile)\core\0Harmony.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(Profile)\interop\*.dll">
      <Private>false</Private>
    </Reference>
    <!-- the Big Puzzle SDK mod, for The Tree's plinths (the gondola opens when they hold gourds) -->
    <Reference Include="$(Profile)\plugins\markviews-BigPuzzleSDK\BigPuzzleSDK.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
